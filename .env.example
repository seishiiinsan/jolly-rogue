# Copier en .env (jamais commité) : cp .env.example .env
# Le mot de passe est injecté tel quel dans DATABASE_URL : évite les caractères
# réservés des URL (@ : / ? # %) ou encode-les.
POSTGRES_USER=jolly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jolly_rogue

# Ports hôte (toujours liés à 127.0.0.1). Décommente pour changer.
# POSTGRES_PORT=5432
# ADMINER_PORT=8080

# Pipeline : uid/gid du propriétaire de ./data sur l'hôte (`id -u` / `id -g`). Défaut : 1000.
# PIPELINE_UID=1000
# PIPELINE_GID=1000
# User-Agent des requêtes HTTP (défaut : jolly-rogue-data-pipeline/… avec l'URL du dépôt).
# PIPELINE_USER_AGENT=
